# ChemMind Backend Configuration
# Copy this file to .env and modify values as needed

# Application
CHEMMIND_PROJECT_NAME="ChemMind Backend API"
CHEMMIND_API_V1_STR="/api/v1"
CHEMMIND_ENVIRONMENT="development"

# Security & JWT (CHANGE IN PRODUCTION!)
CHEMMIND_SECRET_KEY="chemmind_super_secret_key_change_in_production_32bytes_minimum_length"
CHEMMIND_ALGORITHM="HS256"
CHEMMIND_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS
CHEMMIND_BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage
CHEMMIND_STORAGE_DIR="./uploads"
CHEMMIND_MAX_UPLOAD_SIZE_MB=50
CHEMMIND_ALLOWED_EXTENSIONS=[".pdf",".txt",".md",".csv",".tex",".tsv",".json",".rst",".org",".log"]

# Workspace Quota Limits
CHEMMIND_DEFAULT_WORKSPACE_DOC_LIMIT=50
CHEMMIND_DEFAULT_WORKSPACE_STORAGE_MB=500
CHEMMIND_DEFAULT_WORKSPACE_AI_REQUEST_LIMIT=200

# Database
CHEMMIND_DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/chemmind_db"

# AI Configuration
CHEMMIND_OLLAMA_BASE_URL="http://localhost:11434"
CHEMMIND_DEFAULT_LLM_MODEL="qwen2.5:1.5b"
CHEMMIND_DEFAULT_EMBEDDING_MODEL="hf.co/CompendiumLabs/bge-base-en-v1.5-gguf:latest"

# Logging
CHEMMIND_LOG_LEVEL="INFO"