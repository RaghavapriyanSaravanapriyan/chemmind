  "query": "\n        UPDATE workspaces SET\n            name = COALESCE($1, name),\n            description = COALESCE($2, description),\n            is_archived = COALESCE($3, is_archived),\n            updated_at = NOW()\n        WHERE id = $4\n        RETURNING id, name, description, owner_id, is_archived, created_at, updated_at\n        ",
